<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>US Stock Option & Defense Radar</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto space-y-6">
        <!-- 頂部標題列 -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-slate-800 pb-4 gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-wider text-cyan-400">🛡️ US Stock & Options Defense Radar</h1>
                <p class="text-xs text-slate-400 mt-1">專為細價國防/科技股而設嘅 IV 監控、期權策略與財經指標交叉比較台</p>
            </div>
            <div class="flex items-center gap-2 w-full md:w-auto">
                <input type="text" id="newTicker" placeholder="輸入代號 (例: TSLA)" class="bg-slate-900 border border-slate-700 px-3 py-1.5 rounded text-sm uppercase w-full md:w-36 focus:outline-none focus:border-cyan-500">
                <button onclick="addStock()" class="bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-bold px-4 py-1.5 rounded text-sm transition cursor-pointer">新增</button>
            </div>
        </header>

        <!-- 股票快速切換與監控主卡片 -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- 左側：自選股清單 -->
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">📌 監控清單 (Watchlist)</h2>
                    <div id="stockList" class="space-y-2">
                        <!-- 动态生成 -->
                    </div>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800 text-xs text-slate-500">
                    💡 提示：點擊股票可即時切換下方嘅詳細策略同指標面板。
                </div>
            </div>

            <!-- 右側：當前選中股票嘅詳細指標與期權策略 (Parallel Strategy) -->
            <div class="lg:col-span-2 bg-slate-900/60 border border-slate-800 rounded-xl p-6 space-y-6">
                <div class="flex justify-between items-start">
                    <div>
                        <span id="activeTickerBadge" class="bg-cyan-500/10 text-cyan-400 text-xs font-semibold px-2.5 py-1 rounded border border-cyan-500/20">ONDS</span>
                        <h2 id="activeStockName" class="text-xl font-bold mt-2">Ondas Holdings Inc.</h2>
                    </div>
                    <div class="text-right">
                        <div id="activePrice" class="text-2xl font-mono font-bold">$7.61</div>
                        <div id="activeChange" class="text-xs text-emerald-400 font-mono">-0.12% (-$0.01)</div>
                    </div>
                </div>

                <!-- 核心指標格 -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-slate-950/50 p-3 rounded-lg border border-slate-800/80">
                        <div class="text-xs text-slate-400">IV Rank (IVR)</div>
                        <div id="metricIVR" class="text-lg font-mono font-bold text-amber-400 mt-1">72 (High)</div>
                    </div>
                    <div class="bg-slate-950/50 p-3 rounded-lg border border-slate-800/80">
                        <div class="text-xs text-slate-400">Backlog / 訂單</div>
                        <div id="metricBacklog" class="text-lg font-mono font-bold text-cyan-300 mt-1">$757M</div>
                    </div>
                    <div class="bg-slate-950/50 p-3 rounded-lg border border-slate-800/80">
                        <div class="text-xs text-slate-400">季度燒錢率</div>
                        <div id="metricBurn" class="text-lg font-mono font-bold text-rose-400 mt-1">-$50.6M</div>
                    </div>
                    <div class="bg-slate-950/50 p-3 rounded-lg border border-slate-800/80">
                        <div class="text-xs text-slate-400">建議期權策略</div>
                        <div id="metricStrategy" class="text-xs font-bold text-emerald-400 mt-2">CSP + Credit Spread</div>
                    </div>
                </div>

                <!-- 雙軌並行策略執行建議 (Parallel Strategy Info) -->
                <div class="space-y-3">
                    <h3 class="text-sm font-semibold text-slate-300">⚙️ 策略一 & 策略二 執行面板</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                        <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-1">
                            <div class="font-bold text-cyan-400">策略一：Cash-Secured Puts (CSP)</div>
                            <div class="text-slate-400">周期：1-2 Weeks | IVR > 50 時進場</div>
                            <div id="strat1Details" class="text-slate-300 pt-1">建議 Strike: $7.0 (Delta 0.18)，賺取高 Theta。</div>
                        </div>
                        <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-1">
                            <div class="font-bold text-emerald-400">策略二：Credit Spread (防守)</div>
                            <div class="text-slate-400">周期：3-4 Weeks | 鎖定最大風險</div>
                            <div id="strat2Details" class="text-slate-300 pt-1">建議 Short Delta 0.30 兼買遠期做對沖。</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 跨股份比較區 (Cross Comparison Table) -->
        <section class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 space-y-4">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">📊 多股交叉比較 (Cross-Reference & Metrics Comparison)</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-950 text-slate-400 uppercase text-xs border-b border-slate-800">
                        <tr>
                            <th class="p-3">Ticker</th>
                            <th class="p-3">股價 (Price)</th>
                            <th class="p-3">IV Rank</th>
                            <th class="p-3">估值 / 營收增速</th>
                            <th class="p-3">現金流狀態</th>
                            <th class="p-3">操作評級</th>
                        </tr>
                    </thead>
                    <tbody id="comparisonTableBody" class="divide-y divide-slate-800/60 font-mono text-xs">
                        <!-- 動態填充 -->
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        // 模擬數據庫 (支援前端 Add/Remove)
        let stockData = {
            "ONDS": { name: "Ondas Holdings Inc.", price: 7.61, change: "-0.12%", ivr: 72, backlog: "$757M", burn: "-$50.6M", strategy: "CSP + Credit Spread", strat1: "建議 Strike: $7.0 (Delta 0.18)", strat2: "Short $8 Call / Long $9 Call Spread", val: "高增長 (13x YoY)", cash: "燒錢擴張型", rating: "⚠️ 高危高回報" },
            "TSLA": { name: "Tesla Inc.", price: 215.40, change: "+1.45%", ivr: 45, backlog: "N/A", burn: "+$2.1B (Positive)", strategy: "Covered Call", strat1: "遠期 OTM CC 收息", strat2: "等待回調做 CSP", val: "成熟科技估值", cash: "強勁正向", rating: "🟢 穩健佈局" },
            "NVDA": { name: "Nvidia Corp.", price: 124.80, change: "+2.30%", ivr: 58, backlog: "巨大", burn: "+$14B (Positive)", strategy: "Credit Put Spread", strat1: "牛市帶支撐位做 Put Spread", strat2: "避開高引伸買 Call", val: "AI 龍頭", cash: "現金印鈔機", rating: "🔥 強勢追板" }
        };

        let currentActive = "ONDS";

        function renderApp() {
            renderList();
            renderActiveDetails();
            renderComparisonTable();
        }

        function renderList() {
            const listEl = document.getElementById("stockList");
            listEl.innerHTML = "";
            Object.keys(stockData).forEach(ticker => {
                const isSelected = ticker === currentActive;
                const div = document.createElement("div");
                div.className = `flex justify-between items-center p-3 rounded-lg border transition cursor-pointer ${isSelected ? 'bg-cyan-950/40 border-cyan-500/50 text-cyan-300' : 'bg-slate-950/40 border-slate-800/60 hover:bg-slate-800/50 text-slate-300'}`;
                div.innerHTML = `
                    <div onclick="switchStock('${ticker}')" class="flex-1">
                        <div class="font-bold font-mono">${ticker}</div>
                        <div class="text-xs text-slate-400 truncate max-w-[120px]">${stockData[ticker].name}</div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-xs">$${stockData[ticker].price}</span>
                        ${Object.keys(stockData).length > 1 ? `<button onclick="removeStock(event, '${ticker}')" class="text-slate-500 hover:text-rose-400 text-xs px-1">✕</button>` : ''}
                    </div>
                `;
                listEl.appendChild(div);
            });
        }

        function switchStock(ticker) {
            currentActive = ticker;
            renderApp();
        }

        function renderActiveDetails() {
            const data = stockData[currentActive];
            if (!data) return;
            document.getElementById("activeTickerBadge").innerText = currentActive;
            document.getElementById("activeStockName").innerText = data.name;
            document.getElementById("activePrice").innerText = `$${data.price}`;
            document.getElementById("activeChange").innerText = data.change;
            document.getElementById("metricIVR").innerText = `${data.ivr} (High)`;
            document.getElementById("metricBacklog").innerText = data.backlog;
            document.getElementById("metricBurn").innerText = data.burn;
            document.getElementById("metricStrategy").innerText = data.strategy;
            document.getElementById("strat1Details").innerText = data.strat1;
            document.getElementById("strat2Details").innerText = data.strat2;
        }

        function renderComparisonTable() {
            const tbody = document.getElementById("comparisonTableBody");
            tbody.innerHTML = "";
            Object.keys(stockData).forEach(ticker => {
                const d = stockData[ticker];
                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-900/40 border-b border-slate-800/40";
                tr.innerHTML = `
                    <td class="p-3 font-bold text-cyan-400">${ticker}</td>
                    <td class="p-3">$${d.price}</td>
                    <td class="p-3 text-amber-400">${d.ivr}</td>
                    <td class="p-3 text-slate-300">${d.val}</td>
                    <td class="p-3 text-slate-300">${d.cash}</td>
                    <td class="p-3 font-bold">${d.rating}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function addStock() {
            const input = document.getElementById("newTicker");
            const ticker = input.value.trim().toUpperCase();
            if (!ticker) return;
            if (stockData[ticker]) {
                alert("呢隻股票已經喺監控清單入面！");
                return;
            }
            // 模擬新增一隻新股票預設資料
            stockData[ticker] = {
                name: `${ticker} Corporation`,
                price: (Math.random() * 100 + 10).toFixed(2),
                change: "+1.20%",
                ivr: Math.floor(Math.random() * 50 + 30),
                backlog: "$120M",
                burn: "-$12M",
                strategy: "CSP (策略一)",
                strat1: "建議保守行使價",
                strat2: "維持遠期保護",
                val: "中等增長",
                cash: "平衡",
                rating: "⚖️ 觀察中"
            };
            input.value = "";
            currentActive = ticker;
            renderApp();
        }

        function removeStock(event, ticker) {
            event.stopPropagation();
            delete stockData[ticker];
            const remaining = Object.keys(stockData);
            if (currentActive === ticker && remaining.length > 0) {
                currentActive = remaining[0];
            }
            renderApp();
        }

        // 初始化行
        renderApp();
    </script>
</body>
</html>
